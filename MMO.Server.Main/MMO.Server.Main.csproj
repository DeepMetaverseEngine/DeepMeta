<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.2.17</Version>
    <Deterministic>true</Deterministic>
    <LangVersion>latest</LangVersion>
    <Configurations>Debug;Release;Source</Configurations>
  </PropertyGroup>
  <PropertyGroup>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>DeepMeta.$(AssemblyName)</PackageId>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <Optimize>false</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Source'">
    <Optimize>false</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Source'">
    <Optimize>false</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="lang\**" />
    <EmbeddedResource Remove="lang\**" />
    <None Remove="lang\**" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="serverlist.xml" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\DeepCore\DeepCore.Geometry\DeepCore.Geometry.csproj" />
    <ProjectReference Include="..\..\DeepCore\DeepCore.Template.MoonSharp\DeepCore.Template.MoonSharp.csproj" />
    <ProjectReference Include="..\..\DeepCore\DeepCore.Voxel\DeepCore.Voxel.csproj" />
    <ProjectReference Include="..\..\DeepCore\DeepCore\DeepCore.csproj" />
    <ProjectReference Include="..\..\DeepCore\DeepCrystal\DeepCrystal.csproj" />
    <ProjectReference Include="..\..\DeepFrozen\DeepFrozen.MySQL\DeepFrozen.MySQL.csproj" />
    <ProjectReference Include="..\..\DeepFrozen\DeepFrozen.Redis\DeepFrozen.Redis.csproj" />
    <ProjectReference Include="..\..\DeepFrozen\DeepFrozen.RPC.ICE\DeepFrozen.RPC.ICE.csproj" />
    <ProjectReference Include="..\..\DeepFrozen\DeepFrozen.RPC\DeepFrozen.RPC.csproj" />
    <ProjectReference Include="..\..\DeepFrozen\DeepFrozen.Server.NetUV\DeepFrozen.Server.NetUV.csproj" />
    <ProjectReference Include="..\..\DeepFrozen\DeepTools.DBLauncher\DeepTools.DBLauncher.csproj" />
    <ProjectReference Include="..\Gate.Client\Gate.Client.csproj" />
    <ProjectReference Include="..\Gate.Data\Gate.Data.csproj" />
    <ProjectReference Include="..\Gate.Server.Main\Gate.Server.Main.csproj" />
