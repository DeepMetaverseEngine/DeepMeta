<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<appSettings>
		<add key="data_root"        value=".." />
		<add key="codec_class"      value="ZuMa.Client.GenClient.ZuMaBattleCodec" />
		<add key="data_class"       value="Zuma.Core.Battle.ZumaZoneDataFactory" />
		<add key="zone_host_class"  value="Zuma.Core.Battle.ZumaZoneHostFactory" />
		<add key="zone_slave_class" value="Zuma.Core.Battle.ZumaZoneSlaveFactory" />

		<add key="fgui_root"        value="..\FGUIEditor\assets" />

		<add key="build_func"       value="" />
		<add key="edit_class"       value="X.Editor.XGamePlugin3D" />
		<add key="u3d_editor"       value="..\UnityZuma\Zuma.exe -editor=1 -SceneEditor=1 &quot;-resRoot={EditorRoot}/res&quot; &quot;-editorRoot={EditorRoot}&quot; -host={EditorHost} -port={EditorPort} -parentHWND {HWND} delayed " />
		<add key="u3d_preview"      value="..\UnityZuma\Zuma.exe -editor=1     -Preview=1 &quot;-resRoot={EditorRoot}/res&quot; &quot;-editorRoot={EditorRoot}&quot; -host={EditorHost} -port={EditorPort} -parentHWND {HWND} delayed " />
		<add key="u3d_view"         value="..\UnityZuma\Zuma.exe -editor=1    -Resource=1 &quot;-resRoot={EditorRoot}/res&quot; &quot;-editorRoot={EditorRoot}&quot; -host={EditorHost} -port={EditorPort} -file={File} -dir={Dir} -resID={ResID} -resType={ResType} -resList={IsResList}" />
		<add key="u3d_runtime"      value="..\UnityZuma\Zuma.exe -battle=1                &quot;-resRoot={EditorRoot}/res&quot; &quot;-editorRoot={EditorRoot}&quot; -SceneID={SceneID} -ActorTemplateID={ActorTemplateID} -ScreenSize=720x1440" />
		<add key="u3d_mmo"          value="..\UnityZuma\Zuma.exe -gate=1                  &quot;-editorRoot={EditorRoot}&quot;" />
	</appSettings>
</configuration>
